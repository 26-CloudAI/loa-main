FROM python:3.11-slim

WORKDIR /app

# 학습에 필요한 패키지만 설치 (서버 의존성 제외)
RUN pip install --no-cache-dir "numpy>=2.0" google-cloud-storage

COPY battle_royale/src/ ./src/
COPY battle_royale/bots/ ./bots/
COPY battle_royale/scripts/train/train_boss_bot.py ./scripts/train/

# trained_weights.json은 GCS에서 받아오므로 이미지에 굽지 않음
# (빌드 컨텍스트에 있어도 COPY 하지 않음)

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "scripts/train/train_boss_bot.py"]
# 기본값: 500 에피소드. Cloud Run Job에서 --episodes 등 override 가능
CMD ["--episodes", "500"]
